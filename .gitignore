# Environnement Python
.venv/
__pycache__/
.pytest_cache/
*.pyc

# Variables sensibles
.env

# MLflow
.mlflow/
mlruns/

# Données brutes : ignorées
data/raw/*
!data/raw/.gitkeep

# Données traitées : conserver les documents TXT
data/processed/*
!data/processed/
data/processed/*
!data/processed/text/
data/processed/text/*
!data/processed/text/*.txt
!data/processed/.gitkeep

# Artefacts générés
artifacts/*
!artifacts/.gitkeep
